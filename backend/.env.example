
# Copy to .env  (all values optional in development; sensible defaults are built in)
ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Databases: leave blank to use SQLite / in-memory fallbacks (handy without Docker)
DATABASE_URL=postgresql+psycopg2://trustshare:trustshare@localhost:5432/trustshare
MONGO_URL=mongodb://localhost:27017
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=replace-with-64-random-characters
ADMIN_EMAIL=you@example.com

# AES-256 master keys "version:base64" (generate: python scripts/generate_master_key.py 1). Empty => dev key file.
MASTER_KEYS=

# Storage: local | s3 | azure
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
AZURE_CONNECTION_STRING=
AZURE_CONTAINER=trustshare

# Email (blank SMTP_HOST => emails are written to data/outbox and logged)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# OAuth2 (redirect URI: {BACKEND_URL}/api/auth/oauth/<google|github>/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
